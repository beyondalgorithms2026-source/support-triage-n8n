{"seq":29,"ts":"2026-10-13T03:30:19.593520+00:00","method":"POST","path":"/rest/api/3/issue","status":503,"active_input":"t4-003","pass":"A","target":"jira","fault":"jira:503","body":{"fields":{"project":{"key":"SUP"},"issuetype":{"name":"Task"},"summary":"[bug] CRM sync broken since the update","description":{"type":"doc","version":1,"content":[{"type":"paragraph","content":[{"type":"text","text":"Hello,\n\nWriting on behalf of Kettlewick Ltd. Our CRM sync stopped working after your last release: no new events have arrived since then.\n\nOur sales team depends on this sync, and we have no other way to move the data. The webhook settings still show the endpoint as active, and the test button returns success. We are not happy that this happened at all.\n\nThis is blocking us right now, so we need help today. Please investigate as soon as possible.\n\nThanks,\n[NAME_1]\nproject manager, Kettlewick Ltd"}]},{"type":"paragraph","content":[{"type":"text","text":"category=bug (0.977023) priority=P2 (0.991423) urgency=high ticket_ref=751f70fc4caf5eb612e6"}]}]},"labels":["t4","t4dk-751f70fc4caf5eb612e6","t4-cat-bug"],"priority":{"name":"High"}}}}
